# ==============================================================================
# 🪺 Cipher Nest - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the root directory and update the values.
# Do NOT commit your actual '.env' file containing secrets to version control.

# ------------------------------------------------------------------------------
# 🌐 General Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 🗄️ Database Configuration (packages/db)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cipher_nest

# Pooler tuning parameters (Optional, defaults shown below)
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# Disable prepared statements if using PgBouncer/Supabase pooler in Transaction Mode.
# Set to "false" to bypass prepared statements, otherwise set to "true" or omit.
DB_PREPARE=true

# ------------------------------------------------------------------------------
# 🔌 API Server Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=debug

# Enable IP resolution behind reverse proxies (true / false)
TRUST_PROXY=false

# CORS Allowed Origins (Comma-separated list, e.g. http://localhost:3000,https://app.example.com)
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# ⚙️ Redis / Task Queue Configuration (apps/worker & apps/api)
# ------------------------------------------------------------------------------
# Redis connection coordinates for BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 💻 Next.js Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
# Backend API Base URL accessed from the client browser
NEXT_PUBLIC_API_URL=http://localhost:3001
