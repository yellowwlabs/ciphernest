NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/cipher_nest
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_PREPARE=true

BACKEND_PORT=3001

HOST=0.0.0.0

LOG_LEVEL=debug

TRUST_PROXY=false

ALLOWED_ORIGINS=http://localhost:3000

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nyour_privy_public_key\n-----END PUBLIC KEY-----"
